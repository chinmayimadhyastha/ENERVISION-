# ==============================================================================
# ENERVISION — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root and customize as needed.
# Do not commit `.env` containing sensitive credentials or production secrets.
# ==============================================================================

# Application Environment
ENV=development
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# Relational Database URL
# Defaults to SQLite in data/enervision.db if omitted.
# Example for PostgreSQL: postgresql://user:password@localhost:5432/enervision
DATABASE_URL=sqlite:///data/enervision.db

# Future Weather Provider
# Options: "open-meteo" (uses Open-Meteo free API for plants with coordinates)
#          "unavailable" (strict test/offline mode; returns structured weather_required)
FUTURE_WEATHER_PROVIDER=open-meteo

# External Weather API Configuration (Optional)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# CORS Allowed Origins (Comma-separated)
# Must include your frontend development server URL(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
