# ============================================================
# ENERVISION Frontend - Environment Configuration
# ============================================================
# Copy this file to `.env` and adjust as needed.
#
# When VITE_API_BASE_URL is EMPTY, the app runs in fully
# self-contained DEMO mode using local mock data
# (see src/services/mockData.js).
#
# When VITE_API_BASE_URL is set, the API layer
# (src/services/api.js) calls the real ENERVISION
# backend and nothing else. There is NO demo fallback:
# if a request fails the UI shows an error state instead
# of demo data.
# ============================================================

# Real backend base URL. The `/api` prefix is added automatically.
# Examples: http://localhost:5000  or  http://localhost:5000/api
# Leave empty to use built-in demo data (demo mode).
VITE_API_BASE_URL=

# Optional: simulated network latency (ms) for the demo layer
VITE_DEMO_LATENCY=350

# Optional: enable verbose demo/API logging in the console
VITE_DEBUG=false
